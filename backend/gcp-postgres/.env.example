# Cloud SQL instance must be connected to Cloud Run with --add-cloudsql-instances
ATPL_PG_MODE=0
PGHOST=/cloudsql/YOUR_PROJECT:asia-south1:YOUR_INSTANCE
PGPORT=5432
PGDATABASE=atpl_erp
PGUSER=atpl_app
# Store password and token ONLY in Google Secret Manager; do not commit real values.
PGPASSWORD=REPLACE_USING_SECRET_MANAGER
ATPL_SYNC_BEARER=REPLACE_WITH_RANDOM_LONG_SERVER_SIDE_SECRET
# This is a temporary server-to-server testing guard, NOT a browser auth solution.
# Do not activate ATPL_PG_MODE until login integration, migration and tests are complete.
